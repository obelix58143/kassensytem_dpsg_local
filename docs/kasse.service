# Vorlage für den Autostart per systemd.
# Anpassen: User und WorkingDirectory/ExecStart auf euren Benutzer und Programmordner.
[Unit]
Description=Kasse (lokales Kassensystem)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/kasse
ExecStart=/home/pi/kasse/venv/bin/python3 /home/pi/kasse/main.py
Restart=always
RestartSec=3
Environment=PORT=5000

[Install]
WantedBy=multi-user.target
